---
import PlotFigure from "../components/PlotFigure.astro";
import * as Plot from "@observablehq/plot";
import penguins from "../assets/penguins.json";
---

<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <title>TP1 : Astro + Observable Plot</title>
  </head>
  <body>
	<main>
     <h1>Penguins</h1>
    <PlotFigure
      options={{
        title: "Longueur et profondeur du bec des manchots",
        subtitle: "Par espèce : Adelie, Chinstrap, Gentoo",
        caption: "Figure 1. Nuage de points culmen_length_mm vs culmen_depth_mm.",
        ariaLabel: "Nuage de points comparant la longueur et la profondeur du bec de trois espèces de manchots",
        marks: [
          Plot.dot(penguins, {
            x: "culmen_length_mm",
            y: "culmen_depth_mm",
            stroke: "species",
          }),
        ],
      }}
    />
	    <h1>Répartition des masses</h1>
    <PlotFigure
      options={{
        marks: [
          Plot.rectY(
            penguins,
            Plot.binX({ y: "count" }, { x: "body_mass_g" })
          ),
          Plot.ruleY([0]),
        ],
      }}
    />
	</main>
  </body>
</html>