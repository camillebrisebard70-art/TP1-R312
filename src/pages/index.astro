---
import Layout from "../layouts/Layout.astro";
import PlotFigure from "../components/PlotFigure.astro";
import * as Plot from "@observablehq/plot";
import penguins from "../assets/penguins.json";
---

<Layout title="Manchots d'Observable Plot">
  <div class="card">
    <h2>Morphologie du bec</h2>
    <PlotFigure
      options={{
        title: "Longueur et profondeur du bec des manchots",
        subtitle: "Par espèce : Adelie, Chinstrap, Gentoo",
        caption: "Figure 1. Nuage de points culmen_length_mm vs culmen_depth_mm.",
        ariaLabel: "Nuage de points comparant la longueur et la profondeur du bec de trois espèces de manchots",
        marks: [
          Plot.dot(penguins, {
            x: "culmen_length_mm",
            y: "culmen_depth_mm",
            stroke: "species",
          }),
        ],
      }}
    />
  </div>

  <div class="card">
    <h2>Répartition des masses</h2>
    <PlotFigure
      options={{
        title: "Distribution de la masse corporelle",
        marks: [
          Plot.rectY(penguins, Plot.binX({ y: "count" }, { x: "body_mass_g" })),
          Plot.ruleY([0]),
        ],
      }}
    />
  </div>
</Layout>