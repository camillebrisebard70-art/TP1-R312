---
import PlotFigure from "../components/PlotFigure.astro";
import * as Plot from "@observablehq/plot";
import penguins from "../assets/penguins.json";
---

<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <title>TP1 : Astro + Observable Plot</title>
  </head>
  <body>
    <h1>Penguins</h1>
    <PlotFigure
      options={{
        marks: [
          Plot.dot(penguins, {
            x: "culmen_length_mm",
            y: "culmen_depth_mm",
            stroke: "species",
          }),
        ],
      }}
    />
	    <h1>Répartition des masses</h1>
    <PlotFigure
      options={{
        marks: [
          Plot.rectY(
            penguins,
            Plot.binX({ y: "count" }, { x: "body_mass_g" })
          ),
          Plot.ruleY([0]),
        ],
      }}
    />
  </body>
</html>