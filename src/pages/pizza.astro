---
import Layout from "../layouts/Layout.astro";
import PlotFigure from "../components/PlotFigure.astro";
import * as Plot from "@observablehq/plot";
import fs from "node:fs";
import path from "node:path";

const csvPath = path.join(process.cwd(), "src/assets/pizza.csv");
const raw = fs.readFileSync(csvPath, "utf-8").trim();
const [headerLine, ...lines] = raw.split("\n");
const headers = headerLine.split(",");

const pizzas = lines.map((line) => {
  const values = line.split(",");
  const row = {};
  headers.forEach((h, i) => (row[h] = values[i]));
  return {
    ...row,
    price: Number(row.price),
    orders: Number(row.orders),
    revenue: Number(row.revenue),
  };
});
---

<Layout title="Ventes de pizzas">
  <div class="card">
    <h2>Chiffre d'affaires par catégorie</h2>
    <PlotFigure
      options={{
        title: "Revenu total par catégorie de pizza",
        marks: [
          Plot.barY(pizzas, Plot.groupX({ y: "sum" }, { x: "category", y: "revenue" })),
          Plot.ruleY([0]),
        ],
      }}
    />
  </div>

   <div class="card">
    <h2>Pizzas les plus commandées</h2>
    <PlotFigure
      options={{
        title: "Total des commandes par pizza",
        ariaLabel: "Diagramme en barres horizontales du nombre total de commandes par type de pizza",
        marginLeft: 180,
        marks: [
          Plot.barX(
            pizzas,
            Plot.groupY(
              { x: "sum" },
              { y: "name", x: "orders", sort: { y: "-x" } }
            )
          ),
          Plot.ruleX([0]),
        ],
      }}
    />
  </div>
</Layout>